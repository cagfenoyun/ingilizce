  if (!val || !myTeamId) { closeNameEditModal(); return; }
  myTeamName = val;
  update(roomRef('teams/' + myTeamId), { name: val });
  closeNameEditModal();
}
$('name-edit-cancel').addEventListener('click', closeNameEditModal);
$('name-edit-save').addEventListener('click', saveNameEdit);
$('name-edit-input').addEventListener('keydown', e => { if (e.key === 'Enter') saveNameEdit(); if (e.key === 'Escape') closeNameEditModal(); });
$('name-edit-overlay').addEventListener('click', function (e) { if (e.target === this) closeNameEditModal(); });

function makeEditBtn(name, small) {
  const b = document.createElement('button');
  b.type = 'button';
  b.className = 'edit-name-btn' + (small ? ' small' : '');
  b.innerHTML = '✏️';
  b.title = 'Sınıf adını düzenle';
  b.addEventListener('click', e => { e.stopPropagation(); openNameEditModal(name); });
  return b;
}

function enterLobby() {
  showScreen('lobby');
  $('room-badge').style.display = 'flex';
  $('room-badge-code').textContent = currentRoomCode;
  $('lobby-code-val').textContent = currentRoomCode;
}

function renderLobbyTeams(data) {
  const wrap = $('lobby-teams-wrap');
  wrap.innerHTML = '';
  const teams = data.teams || {};
  const ids = Object.keys(teams);
  $('lobby-count').textContent = ids.length + ' sınıf katıldı';
  if (!ids.length) {
    const e = document.createElement('div');
    e.className = 'lobby-empty-hint'; e.textContent = 'Henüz kimse katılmadı.';
    wrap.appendChild(e);
    return;
  }
  ids.forEach(id => {
    const t = teams[id];
    const slot = document.createElement('div');
    slot.className = 'team-slot' + (id === myTeamId ? ' me' : '');
    const row = document.createElement('div');
    row.className = 'tname-row';
    const nd = document.createElement('div');
    nd.className = 'tname'; nd.textContent = t.name;
    row.appendChild(nd);
    if (id === myTeamId) row.appendChild(makeEditBtn(t.name, false));
    slot.appendChild(row);
    const st = document.createElement('div');
    st.className = 'tstatus ' + (t.ready ? 'ready' : 'waiting');
    st.textContent = t.ready ? 'HAZIR' : 'Bekleniyor';
    slot.appendChild(st);
    if (id === data.hostId) {
      const h = document.createElement('div');
      h.className = 'host-tag'; h.textContent = '👑 Kurucu';
      slot.appendChild(h);
    }
    wrap.appendChild(slot);
  });
}

function setupLobbyListeners() {
  onValue(roomRef(), function (snap) {
    const data = snap.val();
    if (!data) return;
    renderLobbyTeams(data);
    const teams = data.teams || {};
    const ids = Object.keys(teams);
    const amIHost = (myTeamId === data.hostId);
    const allReady = ids.length > 0 && ids.every(id => teams[id].ready);
    const startBtn = $('lobby-start-btn'), readyBtn = $('lobby-ready-btn'), hint = $('lobby-hint');

    if (amIHost) {
      startBtn.style.display = 'inline-block';
      startBtn.disabled = !(ids.length >= MIN_TEAMS && allReady && data.status === 'lobby');
      if (data.status === 'lobby') {
        if (ids.length < MIN_TEAMS) hint.textContent = 'Başlamak için en az ' + MIN_TEAMS + ' sınıf gerekiyor.';
        else if (!allReady) hint.textContent = 'Tüm sınıfların hazır olmasını bekleyin.';
        else hint.textContent = 'Hazırsınız! İstediğiniz zaman başlatabilirsiniz.';
      }
    } else {
      startBtn.style.display = 'none';
    }
    if (teams[myTeamId] && teams[myTeamId].ready) readyBtn.disabled = true;
    if (data.status === 'starting') startCountdown();
    if (data.status === 'playing' && screens.lobby.classList.contains('active')) startGameScreen();
  });
}

$('lobby-ready-btn').addEventListener('click', function () {
  update(roomRef('teams/' + myTeamId), { ready: true });
  this.disabled = true;
});
$('lobby-start-btn').addEventListener('click', function () {
  update(roomRef(), { status: 'starting' });
  startCountdown();
});

let countdownStarted = false;
function startCountdown() {
  if (countdownStarted) return;
  countdownStarted = true;
  const overlay = $('countdown-overlay'), numDiv = $('countdown-num');
  overlay.classList.add('active');
  let count = 3;
  numDiv.textContent = count;
  playTick(false);
  const iv = setInterval(function () {
    count--;
    if (count > 0) { numDiv.textContent = count; playTick(false); return; }
    clearInterval(iv);
    playTick(true);
    get(roomRef()).then(snap => {
      const d = snap.val();
      if (d && d.hostId === myTeamId) update(roomRef(), { status: 'playing', currentQ: 0, qStartTime: serverTimestamp() });
    });
  }, 1000);
}

function startGameScreen() { showScreen('game'); setupGameListeners(); }

// ===== SKOR PANOSU =====
let prevScores = {}, scoresInitialized = false;
const MEDALS = ['🥇', '🥈', '🥉'];
const MAX_POINTS = () => QUESTION_BANK.length * 10;

function animateCount(el, from, to, ms) {
  const start = performance.now();
  (function step(now) {
    const p = Math.min(1, (now - start) / ms);
    const eased = 1 - Math.pow(1 - p, 3);
    el.textContent = Math.round(from + (to - from) * eased);
    if (p < 1) requestAnimationFrame(step);
  })(start);
}

function renderScoreboard(data) {
  const strip = $('scoreboard-strip');
  strip.innerHTML = '';
  const teams = data.teams || {};
  const arr = Object.keys(teams).map(id => ({ id, name: teams[id].name, score: teams[id].score || 0 }));
  arr.sort((a, b) => b.score - a.score);
  if (!scoresInitialized) { arr.forEach(t => { prevScores[t.id] = t.score; }); scoresInitialized = true; }
  const topScore = arr.length ? arr[0].score : 0;

  arr.forEach(function (t, idx) {
    const isLeader = topScore > 0 && t.score === topScore;
    const chip = document.createElement('div');
    chip.className = 'score-chip' + (t.id === myTeamId ? ' mine' : '') + (isLeader ? ' leader' : '');

    const rank = document.createElement('div');
    if (idx < 3 && topScore > 0) { rank.className = 'sc-rank medal'; rank.textContent = MEDALS[idx]; }
    else { rank.className = 'sc-rank'; rank.textContent = idx + 1; }
    chip.appendChild(rank);

    const info = document.createElement('div');
    info.className = 'sc-info';
    const nameRow = document.createElement('div');
    nameRow.className = 'sc-name-row';
    const ns = document.createElement('span');
    ns.className = 'sc-name'; ns.textContent = t.name;
    nameRow.appendChild(ns);
    if (t.id === myTeamId) nameRow.appendChild(makeEditBtn(t.name, true));
    const lbl = document.createElement('span');
    lbl.className = 'sc-label'; lbl.textContent = t.id === myTeamId ? 'SİZ' : 'SINIF';
    info.appendChild(nameRow);
    info.appendChild(lbl);
    chip.appendChild(info);

    const ss = document.createElement('div');
    ss.className = 'sc-score';
    const prev = (typeof prevScores[t.id] === 'number') ? prevScores[t.id] : t.score;
    ss.textContent = prev;
    chip.appendChild(ss);

    const bar = document.createElement('div');
    bar.className = 'sc-bar';
    chip.appendChild(bar);
    const pct = Math.min(100, (t.score / MAX_POINTS()) * 100);
    const prevPct = Math.min(100, (prev / MAX_POINTS()) * 100);
    bar.style.width = prevPct + '%';
    requestAnimationFrame(() => requestAnimationFrame(() => { bar.style.width = pct + '%'; }));

    const diff = t.score - prev;
    if (diff > 0) {
      animateCount(ss, prev, t.score, 700);
      const pop = document.createElement('div');
      pop.className = 'score-pop'; pop.textContent = '+' + diff;
      chip.appendChild(pop);
      chip.classList.add('score-bump');
      setTimeout(() => chip.classList.remove('score-bump'), 1000);
      setTimeout(() => pop.remove(), 1300);
    } else {
      ss.textContent = t.score;
    }
    prevScores[t.id] = t.score;
    strip.appendChild(chip);
  });
}

function setupGameListeners() {
  onValue(roomRef(), function (snap) {
    const data = snap.val();
    if (!data || data.status !== 'playing') {
      if (data && data.status === 'finished') showResults(data);
      return;
    }
    currentTeamIds = Object.keys(data.teams || {});
    renderScoreboard(data);
    const qIndex = data.currentQ;
    if (qIndex >= QUESTION_BANK.length) {
      if (data.hostId === myTeamId) update(roomRef(), { status: 'finished' });
      return;
    }
    renderQuestion(qIndex, data);
  });
}

let activeQIndex = -1;
function renderQuestion(qIndex, data) {
  const question = QUESTION_BANK[qIndex];
  if (activeQIndex !== qIndex) {
    activeQIndex = qIndex;
    isAnsweredCurrentQ = false;
    playNewQuestionSound();
    $('q-progress').textContent = "Soru " + (qIndex + 1) + "/" + QUESTION_BANK.length;
    $('q-text').textContent = question.question;
    $('game-status-line').textContent = "";

    const fig = $('q-figure');
    if (question.figure) { fig.innerHTML = question.figure; fig.classList.add('show'); }
    else { fig.innerHTML = ''; fig.classList.remove('show'); }

    const grid = $('options-grid');
    grid.innerHTML = "";
    question.options.forEach(function (text, i) {
      const letter = LETTERS[i];
      const btn = document.createElement('button');
      btn.className = 'opt-btn';
      btn.dataset.letter = letter;
      const badge = document.createElement('div');
      badge.className = 'opt-badge'; badge.textContent = letter;
      const tx = document.createElement('div');
      tx.className = 'opt-text'; tx.textContent = text;
      btn.appendChild(badge); btn.appendChild(tx);
      btn.addEventListener('click', function () {
        if (isAnsweredCurrentQ) return;
        scatterLogosFrom(btn);
        sendAnswer(letter, question.answer);
      });
      grid.appendChild(btn);
    });
    startTimer(data.qStartTime);
  }

  const myData = data.teams[myTeamId];
  if (myData && myData.answer && myData.answer !== "" && !isAnsweredCurrentQ) {
    isAnsweredCurrentQ = true;
    showAnswerFeedback(myData.answer, question.answer);
  }

  const allAnswered = currentTeamIds.every(id => data.teams[id].answer && data.teams[id].answer !== "");
  if (allAnswered && data.hostId === myTeamId) {
    setTimeout(() => advanceToNextQuestion(qIndex), 1500);
  }
}

function startTimer(qStartTime) {
  clearInterval(timerInterval);
  const timerNum = $('timer-num'), ringFg = $('ring-fg');
  const max = 170;
  let lastTick = -1;
  timerInterval = setInterval(function () {
    const elapsed = Math.floor((getServerNow() - qStartTime) / 1000);
    const remaining = Math.max(0, QUESTION_TIME - elapsed);
    timerNum.textContent = remaining;
    ringFg.style.strokeDasharray = max;
    ringFg.style.strokeDashoffset = max - (remaining / QUESTION_TIME) * max;
    ringFg.classList.toggle('warn', remaining <= 5);
    if (remaining <= 5 && remaining > 0 && remaining !== lastTick && !isAnsweredCurrentQ) { lastTick = remaining; playTick(false); }
    if (remaining <= 0) {
      clearInterval(timerInterval);
      disableOptions();
      get(roomRef()).then(snap => {
        const d = snap.val();
        if (d && d.hostId === myTeamId) advanceToNextQuestion(activeQIndex);
      });
    }
  }, 200);
}

function sendAnswer(picked, correct) {
  if (isAnsweredCurrentQ) return;
  isAnsweredCurrentQ = true;
  showAnswerFeedback(picked, correct);
  const isCorrect = picked === correct;
  get(roomRef('teams/' + myTeamId)).then(function (snap) {
    const val = snap.val();
    const cur = (val && val.score) || 0;
    update(roomRef('teams/' + myTeamId), { answer: picked, score: isCorrect ? cur + 10 : cur });
  });
  $('game-status-line').textContent = "Cevabınız iletildi, diğer sınıflar/süre bekleniyor...";
}

function showAnswerFeedback(picked, correct) {
  disableOptions();
  if (picked === correct) playCorrectSound(); else playWrongSound();
  document.querySelectorAll('.opt-btn').forEach(function (b) {
    if (b.dataset.letter === correct) b.classList.add('correct-flash');
    if (b.dataset.letter === picked && picked !== correct) b.classList.add('wrong-pick');
  });
}
function disableOptions() { document.querySelectorAll('.opt-btn').forEach(b => { b.disabled = true; }); }

function advanceToNextQuestion(idx) {
  const updates = { currentQ: idx + 1, qStartTime: serverTimestamp() };
  currentTeamIds.forEach(id => { updates['teams/' + id + '/answer'] = ""; });
  update(roomRef(), updates);
}

function startConfettiRain(container) {
  const layer = document.createElement('div');
  layer.className = 'confetti-layer';
  container.appendChild(layer);
  for (let i = 0; i < 46; i++) {
    const img = document.createElement('img');
    img.src = LOGO_FILES[i % LOGO_FILES.length]; img.alt = ""; img.className = 'confetti-piece';
    img.style.width = (20 + Math.random() * 26) + 'px';
    img.style.left = (Math.random() * 100) + '%';
    img.style.setProperty('--dx', (Math.random() * 160 - 80) + 'px');
    img.style.setProperty('--rot', ((Math.random() * 900 + 360) * (Math.random() < 0.5 ? -1 : 1)) + 'deg');
    img.style.animationDuration = (2.2 + Math.random() * 1.6) + 's';
    img.style.animationDelay = (Math.random() * 1.1) + 's';
    layer.appendChild(img);
  }
  setTimeout(() => layer.remove(), 4200);
}

function runChampionReveal(text) {
  const overlay = $('champion-reveal');
  overlay.innerHTML = '';
  overlay.classList.add('active');
  const stage = document.createElement('div');
  stage.className = 'reveal-logo-stage';
  overlay.appendChild(stage);
  const seq = LOGO_FILES.slice().reverse(), per = 620;
  seq.forEach(function (src, i) {
    setTimeout(function () {
      stage.innerHTML = '';
      const img = document.createElement('img');
      img.src = src; img.alt = ""; img.className = 'reveal-logo-pop';
      stage.appendChild(img);
      bell(659.25 + i * 130, 0.6, 0, 0.12);
    }, i * per);
  });
  const after = seq.length * per + 150;
  setTimeout(function () {
    stage.remove();
    startConfettiRain(overlay);
    const el = document.createElement('div');
    el.className = 'reveal-champion-name'; el.textContent = text;
    overlay.appendChild(el);
    playVictorySound();
  }, after);
  setTimeout(() => overlay.classList.remove('active'), after + 3600);
}

let championRevealPlayed = false;
function showResults(data) {
  clearInterval(timerInterval);
  showScreen('result');
  const teams = data.teams || {};
  const arr = Object.keys(teams).map(id => ({ name: teams[id].name, score: teams[id].score }));
  arr.sort((a, b) => b.score - a.score);
  const list = $('result-list');
  list.innerHTML = '';
  const maxScore = arr.length ? arr[0].score : 0;
  arr.forEach(function (t, idx) {
    const row = document.createElement('div');
    row.className = 'result-row' + (t.score === maxScore ? ' top' : '');
    const rank = document.createElement('span'); rank.className = 'rr-rank'; rank.textContent = (idx + 1) + '.';
    const name = document.createElement('span'); name.className = 'rr-name'; name.textContent = t.name;
    const score = document.createElement('span'); score.className = 'rr-score'; score.textContent = t.score;
    row.appendChild(rank); row.appendChild(name); row.appendChild(score);
    list.appendChild(row);
  });
  const winners = arr.filter(t => t.score === maxScore);
  const headline = $('result-headline');
  if (winners.length === arr.length && arr.length > 1) headline.textContent = "Dostluk Kazandı! Herkes Berabere! 🤝";
  else if (winners.length === 1) headline.textContent = winners[0].name + " Kazandı! 🎉";
  else headline.textContent = winners.map(w => w.name).join(' ve ') + " Berabere Kazandı! 🎉";
  if (!championRevealPlayed) { championRevealPlayed = true; runChampionReveal(headline.textContent); }
}

$('result-newgame').addEventListener('click', () => window.location.reload());
