// ===== SESLER (yumuşak çan/marimba tınısı) =====
let audioCtx = null, masterIn = null;
function getAudioCtx() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  if (audioCtx.state === 'suspended') audioCtx.resume();
  return audioCtx;
}
// Tüm sesler: alçak geçiren filtre -> kompresör -> çıkış (sert tonları yumuşatır)
function getMaster() {
  const c = getAudioCtx();
  if (!masterIn) {
    const lp = c.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 4200; lp.Q.value = 0.5;
    const comp = c.createDynamicsCompressor();
    const g = c.createGain(); g.gain.value = 0.9;
    lp.connect(comp); comp.connect(g); g.connect(c.destination);
    masterIn = lp;
  }
  return masterIn;
}
// Çan/zil benzeri nota: temel ses + üst harmonikler, doğal sönümlü
function bell(freq, dur, delay, peak) {
  try {
    const c = getAudioCtx(), out = getMaster(), t0 = c.currentTime + (delay || 0), p = peak || 0.2;
    [[1, 1, 1], [2, 0.32, 0.55], [3, 0.1, 0.35], [4.2, 0.05, 0.2]].forEach(function (h) {
      const o = c.createOscillator(), g = c.createGain();
      o.type = 'sine'; o.frequency.value = freq * h[0];
      const d = dur * h[2];
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(p * h[1], t0 + 0.012);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + d);
      o.connect(g).connect(out);
      o.start(t0); o.stop(t0 + d + 0.05);
    });
  } catch (e) {}
}
// Yumuşak kayan "bloop" (yanlış cevap için)
function softSlide(f1, f2, dur, delay, peak) {
  try {
    const c = getAudioCtx(), out = getMaster(), o = c.createOscillator(), g = c.createGain();
    o.type = 'sine';
    const t0 = c.currentTime + (delay || 0);
    o.frequency.setValueAtTime(f1, t0);
    o.frequency.exponentialRampToValueAtTime(f2, t0 + dur);
    g.gain.setValueAtTime(0.0001, t0);
    g.gain.exponentialRampToValueAtTime(peak || 0.2, t0 + 0.03);
    g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
    o.connect(g).connect(out);
    o.start(t0); o.stop(t0 + dur + 0.05);
  } catch (e) {}
}
