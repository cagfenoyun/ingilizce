<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>İngilizce Yarışması</title>
<link rel="icon" href="logo10.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--ink:#10302A;--muted:#4E6F67;--red:#1FA463;--red-dark:#0E6B40;--turq:#00A3A3;--turq-dark:#007A7A;--gold:#B58A00;--green:#1F9D55;--wrong:#E8505B;--line:rgba(15,70,55,.15);--card:rgba(255,255,255,.94);--shadow:0 14px 34px rgba(20,90,70,.18)}
*{box-sizing:border-box}
html,body{margin:0;padding:0;height:100%;font-family:'Nunito',sans-serif;color:var(--ink);overflow:auto;-webkit-user-select:none;user-select:none;
background:radial-gradient(circle at 15% 10%,rgba(190,240,170,.7),transparent 45%),radial-gradient(circle at 85% 12%,rgba(150,230,215,.6),transparent 48%),radial-gradient(circle at 88% 90%,rgba(130,225,225,.6),transparent 50%),radial-gradient(circle at 8% 88%,rgba(215,245,160,.55),transparent 48%),linear-gradient(160deg,#F2FBF1,#E9F8F3 50%,#E3F6F8)}
#app{position:relative;width:100vw;min-height:100vh;display:flex;flex-direction:column;z-index:1}
#bg-fx{position:fixed;inset:0;overflow:hidden;z-index:0;pointer-events:none}
.glow-orb{position:absolute;border-radius:50%;opacity:.3;animation:orbFloat 20s ease-in-out infinite;will-change:transform;transform:translateZ(0)}
.intro-on .glow-orb,.intro-on .math-sym,.intro-on .bg-floater{animation-play-state:paused}
@keyframes orbFloat{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(60px,-40px) scale(1.15)}66%{transform:translate(-50px,50px) scale(.92)}}
.math-sym{position:absolute;font-family:'Baloo 2',Georgia,serif;font-weight:800;line-height:1;user-select:none;will-change:transform;opacity:.42;text-shadow:0 0 10px currentColor;animation:symDrift ease-in-out infinite}
@keyframes symDrift{0%,100%{transform:translate(0,0) rotate(var(--r0))}50%{transform:translate(var(--dx),var(--dy)) rotate(var(--r1))}}
@keyframes neonPulse{0%{opacity:.32;text-shadow:0 0 5px currentColor,0 0 14px currentColor}100%{opacity:.6;text-shadow:0 0 9px currentColor,0 0 26px currentColor,0 0 44px currentColor}}
#bg-floaters{position:fixed;inset:0;overflow:hidden;z-index:0;pointer-events:none}
.bg-floater{position:absolute;opacity:.45;will-change:transform;animation:floatDrift ease-in-out infinite}
@keyframes floatDrift{0%,100%{transform:translate(0,0) rotate(0)}25%{transform:translate(22px,-34px) rotate(7deg)}50%{transform:translate(-16px,-58px) rotate(-5deg)}75%{transform:translate(18px,-30px) rotate(4deg)}}
.burst-layer{position:fixed;left:0;top:0;width:0;height:0;z-index:9999;pointer-events:none}
.burst-piece{position:absolute;width:64px;height:64px;object-fit:contain;transform:translate(-50%,-50%);animation:burstFly 1.8s cubic-bezier(.15,.7,.25,1) forwards;filter:drop-shadow(0 6px 12px rgba(0,0,0,.3))}
@keyframes burstFly{0%{transform:translate(-50%,-50%) scale(.6);opacity:1}12%{transform:translate(-50%,-50%) scale(1.25);opacity:1}70%{transform:translate(calc(-50% + var(--tx)*.9),calc(-50% + var(--ty)*.9)) scale(.85) rotate(calc(var(--rot)*.85));opacity:1}100%{transform:translate(calc(-50% + var(--tx)),calc(-50% + var(--ty))) scale(.3) rotate(var(--rot));opacity:0}}
#topbar{display:flex;align-items:center;gap:20px;padding:12px 40px;background:rgba(255,255,255,.88);border-bottom:1px solid var(--line);position:relative;z-index:20;flex-shrink:0}
.brand-icon{height:60px;width:auto;flex-shrink:0;object-fit:contain;filter:drop-shadow(0 4px 8px rgba(20,90,70,.25))}
.brand-text{display:flex;flex-direction:column;line-height:1.05}
.brand-text .club{font-family:'Baloo 2';font-weight:800;font-size:30px;color:var(--red-dark)}
.brand-text .sub{font-size:16px;color:var(--muted);font-weight:700}
.spacer{flex:1}
#room-badge{display:none;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);padding:10px 20px;border-radius:16px;font-family:'Baloo 2';font-size:19px;font-weight:700;color:var(--muted)}
#room-badge b{color:var(--gold);letter-spacing:4px;font-size:22px}
#fs-btn{background:#fff;border:1px solid var(--line);border-radius:14px;height:48px;padding:0 18px;cursor:pointer;font-family:'Baloo 2';font-weight:700;font-size:18px;color:var(--ink);display:inline-flex;align-items:center;gap:8px;box-shadow:0 4px 10px rgba(20,90,70,.12);-webkit-tap-highlight-color:transparent}
#fs-btn:hover{background:#E4F6EA}
#fs-btn:active{transform:scale(.96)}
.screen{display:none;flex:1;min-height:0;flex-direction:column;align-items:center;justify-content:center;padding:20px 32px 36px;position:relative}
.screen.active{display:flex}
.card{background:var(--card);border:1px solid var(--line);border-top:6px solid var(--turq);border-radius:28px;box-shadow:var(--shadow);padding:52px 60px}
h1.title{font-family:'Baloo 2';font-weight:800;font-size:clamp(38px,5vw,60px);margin:0 0 10px;text-align:center;color:var(--red-dark)}
p.lead{color:var(--muted);font-weight:700;text-align:center;margin:0 0 36px;font-size:22px}
.btn{font-family:'Baloo 2';font-weight:700;font-size:24px;border:none;border-radius:18px;cursor:pointer;padding:20px 38px;color:#fff;transition:.12s ease;-webkit-tap-highlight-color:transparent}
.btn:active{transform:scale(.96)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn-primary{background:linear-gradient(180deg,var(--red),var(--red-dark));box-shadow:0 8px 18px rgba(20,140,85,.3)}
.btn-primary:hover:not(:disabled){filter:brightness(1.08)}
.btn-block{width:100%}
.btn-secondary{background:#DDEBE6;color:var(--ink);box-shadow:none}
.home-columns{display:flex;align-items:stretch;margin-top:10px}
.home-col{flex:1;min-width:0;display:flex;flex-direction:column;gap:22px;padding:6px 28px}
.home-col-head{display:flex;align-items:center;gap:18px}
.home-col-head .emoji{font-size:44px}
.ct{font-family:'Baloo 2';font-weight:700;font-size:26px}
.cs{color:var(--muted);font-size:16px;font-weight:600}
.home-divider{flex-shrink:0;width:2px;align-self:stretch;background:var(--line);position:relative}
.home-divider span{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#F2FBF1;color:var(--muted);font-weight:800;font-size:15px;text-transform:uppercase;padding:10px 6px;border-radius:10px;border:1px solid var(--line)}
.form-panel{width:100%;display:flex;flex-direction:column;gap:18px}
.field label{display:block;font-size:16px;font-weight:800;color:var(--muted);margin-bottom:8px}
.field input{width:100%;padding:18px 20px;border-radius:14px;border:2px solid rgba(15,70,55,.18);background:#fff;color:var(--ink);font-size:23px;font-weight:700;font-family:'Nunito'}
.field input:focus{outline:none;border-color:var(--turq)}
.field input.code-input{letter-spacing:14px;text-align:center;font-family:'Baloo 2';font-size:34px}
.error-msg{color:#8A1620;background:#FFE3E5;border:1px solid #F3A5AB;padding:14px 18px;border-radius:12px;font-weight:700;font-size:18px;display:none}
@media(max-width:860px){.home-columns{flex-direction:column}.home-divider{width:auto;height:2px;margin:8px 0}#topbar{padding:10px 18px}}
.lobby-code{text-align:center;margin-bottom:28px}
.lobby-code .cap{font-size:16px;letter-spacing:2px;color:var(--muted);font-weight:800}
.lobby-code .val{font-family:'Baloo 2';font-size:76px;font-weight:800;color:var(--gold);letter-spacing:20px}
.lobby-count{text-align:center;color:var(--muted);font-weight:800;font-size:17px;margin-bottom:20px}
.lobby-teams-wrap{display:flex;flex-wrap:wrap;gap:18px;justify-content:center;max-width:820px;margin-bottom:10px}
.team-slot{width:210px;min-height:150px;border-radius:20px;padding:20px 16px;background:#fff;border:2px solid var(--line);text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;box-shadow:0 6px 14px rgba(20,90,70,.08)}
.team-slot.me{border-color:var(--turq)}
.tname{font-family:'Baloo 2';font-size:22px;font-weight:700;word-break:break-word}
.tstatus{font-size:15px;font-weight:800;padding:7px 16px;border-radius:20px}
.tstatus.waiting{background:#E4EEEA;color:var(--muted)}
.tstatus.ready{background:#DDF5E7;color:#177A42}
.host-tag{font-size:14px;color:var(--gold);font-weight:800}
.edit-name-btn{background:#E9F3EF;border:1px solid var(--line);border-radius:10px;width:32px;height:32px;cursor:pointer;color:var(--ink);font-size:15px;display:inline-flex;align-items:center;justify-content:center;padding:0;flex-shrink:0}
.edit-name-btn.small{width:26px;height:26px;font-size:12px}
.tname-row{display:flex;align-items:center;gap:8px;justify-content:center}
.lobby-empty-hint{color:var(--muted);font-weight:700;font-size:18px;text-align:center;padding:26px;border:2px dashed var(--line);border-radius:18px;width:100%;max-width:500px}
#lobby-ready-btn,#lobby-start-btn{margin-top:14px}
.status-line{text-align:center;margin-top:24px;font-weight:800;color:var(--muted);font-size:20px;min-height:26px}
.countdown-overlay{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(242,251,241,.93);z-index:30;flex-direction:column;border-radius:28px}
.countdown-overlay.active{display:flex}
.countdown-num{font-family:'Baloo 2';font-weight:800;font-size:200px;color:var(--red);line-height:1}
.countdown-label{font-weight:800;color:var(--muted);letter-spacing:3px;font-size:24px}
.modal-overlay{position:fixed;inset:0;background:rgba(20,60,50,.35);z-index:600;display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)}
.modal-overlay.active{display:flex}
.modal-box{width:min(92vw,420px);background:#fff;border:1px solid var(--line);border-top:5px solid var(--turq);border-radius:22px;box-shadow:var(--shadow);padding:30px;display:flex;flex-direction:column;gap:18px}
.modal-title{font-family:'Baloo 2';font-weight:700;font-size:22px;text-align:center}
#name-edit-input{width:100%;padding:16px 18px;border-radius:12px;border:2px solid rgba(15,70,55,.18);background:#fff;color:var(--ink);font-size:20px;font-weight:700;font-family:'Nunito'}
#name-edit-input:focus{outline:none;border-color:var(--turq)}
.modal-actions{display:flex;gap:12px}
.modal-actions .btn{flex:1;font-size:20px;padding:14px 20px}
#champion-reveal{position:fixed;inset:0;z-index:800;display:none;align-items:center;justify-content:center;flex-direction:column;background:radial-gradient(circle at 50% 40%,#F4FFE6,#C9F0DD);overflow:hidden}
#champion-reveal.active{display:flex}
.reveal-logo-stage{display:flex;align-items:center;justify-content:center;position:absolute;inset:0}
.reveal-logo-pop{width:min(38vw,260px);animation:revealLogoPop .62s cubic-bezier(.34,1.56,.64,1) both;filter:drop-shadow(0 16px 30px rgba(20,90,70,.4))}
@keyframes revealLogoPop{0%{opacity:0;transform:scale(.3) rotate(-22deg)}55%{opacity:1;transform:scale(1.15) rotate(4deg)}100%{opacity:1;transform:scale(1)}}
.confetti-layer{position:absolute;inset:0;pointer-events:none;z-index:1}
.confetti-piece{position:absolute;top:-60px;opacity:.95;animation-name:confettiFall;animation-timing-function:linear;animation-fill-mode:forwards}
@keyframes confettiFall{0%{transform:translate(0,0) rotate(0);opacity:1}100%{transform:translate(var(--dx),115vh) rotate(var(--rot));opacity:.85}}
.reveal-champion-name{font-family:'Baloo 2';font-weight:800;font-size:clamp(34px,5.4vw,68px);text-align:center;padding:0 40px;max-width:1100px;color:var(--red-dark);text-shadow:0 6px 18px rgba(255,255,255,.8);opacity:0;animation:champPop .6s cubic-bezier(.34,1.56,.64,1) forwards;z-index:2}
@keyframes champPop{0%{opacity:0;transform:scale(.4) translateY(20px)}60%{opacity:1;transform:scale(1.12)}100%{opacity:1;transform:scale(1)}}
#screen-game{padding:18px 36px 30px;justify-content:flex-start}
.game-shell{width:100%;max-width:1500px;margin:0 auto;display:flex;flex-direction:column;gap:20px;height:100%;min-height:0}
.meta-row{display:flex;align-items:center;justify-content:space-between;padding:0 8px;gap:20px}
.q-progress{font-weight:800;color:var(--muted);font-size:22px;white-space:nowrap}
.q-category{font-family:'Baloo 2';font-weight:700;font-size:22px;background:#D9F4F4;color:var(--turq-dark);padding:10px 26px;border-radius:26px;border:1px solid rgba(0,163,163,.4)}
.timer-wrap{position:relative;width:104px;height:104px;flex-shrink:0}
.timer-wrap svg{transform:rotate(-90deg);width:104px;height:104px}
.ring-bg{fill:none;stroke:rgba(15,70,55,.12);stroke-width:8}
.ring-fg{fill:none;stroke:var(--gold);stroke-width:8;stroke-linecap:round;transition:stroke-dashoffset .1s linear}
.ring-fg.warn{stroke:var(--wrong)}
.tnum{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Baloo 2';font-weight:800;font-size:34px}

/* ===== SKOR PANOSU ===== */
.scoreboard-strip{display:flex;flex-wrap:wrap;gap:16px;justify-content:center;padding:4px 0}
.score-chip{position:relative;display:flex;align-items:center;gap:14px;min-width:240px;max-width:340px;background:linear-gradient(180deg,#fff,#F1FAF6);border:2px solid var(--line);border-radius:24px;padding:12px 14px 17px 12px;box-shadow:0 8px 20px rgba(20,90,70,.12);overflow:hidden;transition:transform .35s cubic-bezier(.34,1.56,.64,1),box-shadow .3s,border-color .3s}
.score-chip.mine{border-color:var(--turq);box-shadow:0 0 0 3px rgba(0,163,163,.18),0 8px 20px rgba(0,120,120,.18)}
.score-chip.leader{background:linear-gradient(180deg,#FFFBE8,#FFF1BF);border-color:#E8B923;box-shadow:0 10px 24px rgba(200,150,0,.25)}
.score-chip.leader.mine{box-shadow:0 0 0 3px rgba(0,163,163,.28),0 10px 24px rgba(200,150,0,.25)}
.sc-rank{flex-shrink:0;width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Baloo 2';font-weight:800;font-size:22px;color:var(--muted);background:#E4EEEA;box-shadow:inset 0 -3px 0 rgba(0,0,0,.06)}
.sc-rank.medal{background:transparent;box-shadow:none;font-size:34px;filter:drop-shadow(0 3px 4px rgba(0,0,0,.2))}
.sc-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px}
.sc-name-row{display:flex;align-items:center;gap:6px}
.sc-name{font-family:'Baloo 2';font-weight:700;font-size:20px;color:var(--ink);max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sc-label{font-size:11px;font-weight:900;letter-spacing:2px;color:var(--muted);opacity:.75}
.sc-score{flex-shrink:0;min-width:64px;text-align:center;font-family:'Baloo 2';font-weight:800;font-size:30px;line-height:1;color:#fff;padding:8px 14px 6px;border-radius:16px;background:linear-gradient(180deg,#1FB6A6,var(--turq-dark));box-shadow:0 4px 10px rgba(0,120,120,.3),inset 0 2px 0 rgba(255,255,255,.3);text-shadow:0 2px 3px rgba(0,0,0,.2)}
.score-chip.leader .sc-score{background:linear-gradient(180deg,#F8C93A,#D49A00);box-shadow:0 4px 10px rgba(180,130,0,.35),inset 0 2px 0 rgba(255,255,255,.4)}
.sc-bar{position:absolute;left:0;bottom:0;height:6px;width:0;background:linear-gradient(90deg,var(--turq),#8CC63F);border-radius:0 6px 6px 0;transition:width .9s cubic-bezier(.22,1,.36,1)}
.score-chip.leader .sc-bar{background:linear-gradient(90deg,#F8C93A,#E8A400)}
@keyframes bump{0%{transform:scale(1)}35%{transform:scale(1.07) translateY(-3px)}100%{transform:scale(1)}}
.score-chip.score-bump{animation:bump .8s ease}
.score-chip.score-bump .sc-score{animation:scoreFlash .9s ease}
@keyframes scoreFlash{0%{filter:brightness(1)}30%{filter:brightness(1.35);transform:scale(1.18)}100%{filter:brightness(1);transform:scale(1)}}
.score-chip.score-bump::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.75) 50%,transparent 70%);transform:translateX(-120%);animation:shine .9s ease forwards;pointer-events:none}
@keyframes shine{to{transform:translateX(120%)}}
.score-pop{position:absolute;top:6px;right:12px;font-family:'Baloo 2';font-weight:800;font-size:20px;color:#fff;background:linear-gradient(180deg,#34C37A,var(--green));padding:2px 12px;border-radius:14px;box-shadow:0 4px 10px rgba(31,157,85,.45);pointer-events:none;animation:popf 1.3s ease forwards;z-index:2}
@keyframes popf{0%{opacity:0;transform:translateY(10px) scale(.6)}20%{opacity:1;transform:translateY(-6px) scale(1.15)}70%{opacity:1;transform:translateY(-10px) scale(1)}100%{opacity:0;transform:translateY(-26px) scale(.95)}}

.question-card{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:center;background:var(--card);border:1px solid var(--line);border-radius:26px;padding:36px 50px;box-shadow:var(--shadow)}
#q-figure{display:none;justify-content:center;margin-bottom:16px}
#q-figure.show{display:flex}
#q-figure svg{width:min(90%,440px);height:auto;background:#fff;border:1px solid var(--line);border-radius:16px;padding:8px;box-shadow:0 4px 10px rgba(20,90,70,.08)}
.q-text{font-family:'Baloo 2';font-weight:700;font-size:clamp(24px,2.8vw,40px);text-align:center;line-height:1.35;margin-bottom:32px;white-space:pre-line}
.options-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.opt-btn{display:flex;align-items:center;gap:20px;background:#fff;border:3px solid var(--line);border-radius:22px;padding:24px 28px;cursor:pointer;text-align:left;transition:.12s ease;color:var(--ink);box-shadow:0 4px 10px rgba(20,90,70,.08)}
.opt-btn:nth-child(1){border-color:rgba(31,157,85,.55);background:#EDFAF2}.opt-btn:nth-child(2){border-color:rgba(0,163,163,.55);background:#EAFAFA}.opt-btn:nth-child(3){border-color:rgba(230,170,0,.6);background:#FFF8E3}.opt-btn:nth-child(4){border-color:rgba(50,120,220,.55);background:#ECF3FF}
.opt-btn:hover:not(:disabled){filter:brightness(.97);transform:translateY(-2px)}
.opt-btn:disabled{cursor:default}
.opt-badge{flex-shrink:0;width:56px;height:56px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-family:'Baloo 2';font-weight:800;font-size:28px;color:#fff}
.opt-btn:nth-child(1) .opt-badge{background:#1FA463}.opt-btn:nth-child(2) .opt-badge{background:var(--turq-dark)}.opt-btn:nth-child(3) .opt-badge{background:#D49A00}.opt-btn:nth-child(4) .opt-badge{background:#3A78D6}
.opt-text{font-size:25px;font-weight:700;line-height:1.25}
@keyframes cblink{0%,100%{background:#DDF5E7;border-color:var(--green)}50%{background:#A9E8C3;border-color:#1F9D55}}
.opt-btn.correct-flash{animation:cblink .6s ease-in-out 3;border-color:var(--green)!important;background:#C4EFD6!important}
.opt-btn.correct-flash .opt-badge{background:var(--green)!important}
.opt-btn.wrong-pick{border-color:var(--wrong)!important;background:#FFD6D9!important}
.opt-btn.wrong-pick .opt-badge{background:var(--wrong)!important}
.result-trophy{font-size:110px;margin-bottom:10px}
.result-list{display:flex;flex-direction:column;gap:14px;margin:26px auto 10px;max-width:600px;width:100%}
.result-row{display:flex;align-items:center;gap:16px;background:#fff;border:2px solid var(--line);border-radius:18px;padding:18px 26px}
.result-row.top{border-color:var(--gold);background:#FFF6D8}
.rr-rank{font-family:'Baloo 2';font-weight:800;color:var(--muted);width:36px;font-size:22px}
.rr-name{font-family:'Baloo 2';font-weight:700;font-size:24px;flex:1;text-align:left;word-break:break-word}
.rr-score{font-family:'Baloo 2';font-weight:800;font-size:30px;color:var(--gold)}
@media(max-width:900px){.options-grid{grid-template-columns:1fr}.sc-name{max-width:100px}.score-chip{min-width:200px}.question-card{padding:24px 20px}}
#screen-intro{gap:22px;overflow:hidden}
.intro-welcome{display:flex;flex-direction:column;align-items:center;text-align:center;gap:26px;padding:0 20px}
.intro-logo{width:clamp(110px,15vw,190px);height:auto;object-fit:contain;opacity:0;filter:drop-shadow(0 10px 20px rgba(20,90,70,.3));animation:iIn .6s ease .1s forwards,iOut .6s ease 4.2s forwards}
.intro-title{font-family:'Baloo 2';font-weight:800;font-size:clamp(42px,7vw,92px);line-height:1.15;margin:0;background:linear-gradient(90deg,var(--red),#8CC63F 35%,var(--turq) 65%,var(--red));background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:rain 4s linear infinite,pIn .7s cubic-bezier(.34,1.56,.64,1) both,iOut .6s ease 4.2s forwards}
@keyframes rain{to{background-position:300% 50%}}
@keyframes pIn{0%{opacity:0;transform:scale(.6) translateY(20px)}100%{opacity:1;transform:scale(1)}}
@keyframes iOut{to{opacity:0;transform:scale(.94)}}
